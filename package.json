{
  "name": "dsh-workspace-optimize",
  "version": "0.1.1",
  "private": false,
  "description": "工作区浏览器增强插件，通过左侧自定义的增强工作区视图对工作区文件夹和会话实现收藏、置顶、优先级、状态显示以及提醒等功能",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "workspace",
    "sidebar",
    "session-management"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akilonewbility/dsh-workspace-optimize.git"
  },
  "homepage": "https://github.com/akilonewbility/dsh-workspace-optimize#readme",
  "bugs": {
    "url": "https://github.com/akilonewbility/dsh-workspace-optimize/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "license": "MIT"
}
